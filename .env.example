# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Option A (Production / Railway): Set these env vars directly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Option B (Local dev): Use a credentials.json file instead
# GOOGLE_CREDENTIALS_FILE=credentials.json

# The redirect URI you set in Google Cloud Console
# Must match EXACTLY (including trailing slash, http vs https)
#   Local:      http://localhost:8000/oauth/callback
#   Railway:    https://<your-app>.up.railway.app/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=bot_data.db

# ── Security (REQUIRED for production) ────────────────────────────────────────
# Fernet encryption key for stored OAuth tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: If not set, tokens are stored in PLAINTEXT.
TOKEN_ENCRYPTION_KEY=

# ── Temp Storage (Optional) ───────────────────────────────────────────────────
# Per-user sandbox root for temporary files (downloads/ZIPs)
# TEMP_ROOT=./temp

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to WARNING in production to reduce log volume
# LOG_LEVEL=INFO

# ── Step-up Verification (Optional) ───────────────────────────────────────────
# Email OTP for sensitive actions (download/upload/delete)
# Set to true to enable (default: disabled)
STEPUP_VERIFICATION_ENABLED=false

# ── Operational Limits (Optional) ─────────────────────────────────────────────
# MAX_UPLOAD_BYTES=20971520
# MAX_TELEGRAM_DOWNLOAD_BYTES=47185920
# MAX_ZIP_FILES=20
# MAX_ZIP_BYTES=104857600
# MAX_SEARCH_LEN=100
# MAX_FTS_RESULTS=25
# MAX_INDEX_BYTES=5242880
# MAX_INDEX_CHARS=200000
# NLP_CONTEXT_TTL_SECONDS=900
# TASK_WORKERS=2
# TASK_TTL_SECONDS=21600
# RATE_LIMIT_COOLDOWN=3
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_ACTIONS=30

# ── OCR (Optional) ────────────────────────────────────────────────────────────
# Path to tesseract binary if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Access Control (Optional) ─────────────────────────────────────────────────
# Restrict bot usage to specific Telegram user IDs (comma-separated).
# If not set, the bot is open to all users.
# Find your ID: message @userinfobot on Telegram
# ALLOWED_USERS=123456789,987654321

# ── Security Alerts (Optional) ────────────────────────────────────────────────
# Email notifications for suspicious activity (requires Gmail account)
# Uses Gmail SMTP — set sender email and App Password (NOT regular password)
# To generate App Password:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (enable if not already)
#   3. Security → App Passwords → Select "Mail" and "Windows Computer"
#   4. Copy the 16-character password shown (paste without spaces)
ALERT_EMAIL_SENDER=your-gmail@gmail.com
ALERT_EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Admin email to receive alerts when suspicious activity is detected
ADMIN_EMAIL=admin@gmail.com

# ── AI Copilot (Google Gemini) ────────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (default: gemini-2.0-flash — fast, cheap, good for structured output)
GEMINI_MODEL=gemini-2.0-flash

# Max conversation turns to remember per session (default: 10)
COPILOT_MEMORY_TURNS=10

# Conversation memory TTL in seconds (default: 900 = 15 min)
COPILOT_MEMORY_TTL=900

# Set to false to disable LLM and use keyword-only mode (default: true)
COPILOT_ENABLED=true
